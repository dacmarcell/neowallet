@host = http://localhost:8000/api

#### Users

### Get Users

GET {{host}}/v1/users
Accept: application/json

### Create User

POST {{host}}/v1/users
Accept: application/json
Content-Type: application/json

{
    "name": "John Doe",
    "email": "john.doe@example.com",
    "password": "password"
}

### Update User
PATCH {{host}}v1/users/1
Accept: application/json
Content-Type: application/json

{
    "name": "Jane Doe"
}

### Delete User
DELETE {{host}}/v1/users/1
Accept: application/json

#### Authentication

### Login

POST {{host}}/v1/auth/login
Accept: application/json
Content-Type: application/json

{
    "email": "john.doe@example.com",
    "password": "password"
}

### Logout
POST {{host}}/v1/auth/logout
Accept: application/json

### Me
GET {{host}}/v1/auth/me
Accept: application/json